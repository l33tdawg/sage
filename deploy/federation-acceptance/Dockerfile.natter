FROM golang:1.26.8-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 go build -trimpath -o /natter .

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /natter /usr/local/bin/natter
ENTRYPOINT ["natter"]
CMD ["-config", "/etc/natter/natter.yaml"]
